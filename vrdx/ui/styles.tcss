/* Layout and styling for the vrdx Textual TUI */

Screen {
    background: $background;
    color: $text;
    layout: vertical;
}

#main-layout {
    height: 1fr;
    width: 100%;
}

#left-column {
    width: 26%;
    min-width: 20w;
    border-right: solid $primary;
    padding: 1;
}

#decisions-title,
#files-title {
    text-style: bold;
    padding-bottom: 0;
    margin-bottom: 1;
}

#pane-hints {
    padding: 0 1;
    color: $text-muted;
    height: 1;
}

#decision-list,
#file-list {
    border: solid $primary;
    background: $surface;
    height: 1fr;
    min-height: 8;
    padding: 0;
    margin-bottom: 1;
}

#decision-list ListItem:hover,
#file-list ListItem:hover {
    background: $accent;
}

#decision-list ListView:focus ListItem.--highlight,
#file-list ListView:focus ListItem.--highlight {
    background: $accent;
}

#file-list ListItem.file-no-markers {
    color: $text-muted;
    text-style: dim;
}

#file-list ListItem.file-no-markers Label {
    color: $text-muted;
}

#editor-pane,
#preview-pane {
    border: solid $primary;
    padding: 1 2;
    margin: 0 1;
    overflow-y: auto;
    background: $panel;
}

#editor-pane {
    width: 44%;
    min-width: 32w;
}

#preview-pane {
    width: 30%;
    min-width: 24w;
}

#status-bar {
    background: $boost;
    color: $text;
    border-bottom: solid $primary;
    padding: 0 1;
    height: auto;
    min-height: 1;
    content-align: center middle;
}
